-- 2. Create the standard USERS tablespace (exactly the name = USERS)

CREATE TABLESPACE USERS   DATAFILE '/opt/oracle/oradata/FREE/xepdb1/users01.dbf'   SIZE 100M 
  AUTOEXTEND ON NEXT 100M MAXSIZE 20G 
  EXTENT MANAGEMENT LOCAL 
  SEGMENT SPACE MANAGEMENT AUTO; 

-- 3. Assign it to user sferp
drop user sferp cascade ;
create user sferp identified by sferp ;
grant dba to sferp ;

ALTER USER sferp QUOTA UNLIMITED ON USERS;
ALTER USER sferp DEFAULT TABLESPACE USERS;
ALTER USER sferp TEMPORARY TABLESPACE TEMP;

-- 4. Verify everything is correct
SELECT username, default_tablespace, temporary_tablespace, account_status FROM   dba_users WHERE  username = 'SFERP';

SELECT tablespace_name, file_name, bytes/1024/1024 AS mb, autoextensible, maxbytes/1024/1024 AS max_mb FROM   dba_data_files WHERE  tablespace_name = 'USERS';

